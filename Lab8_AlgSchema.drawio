          <mxGeometry x="255" y="310" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cond" value="i &amp;lt; n" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Arial;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="240" y="400" width="120" height="90" as="geometry"/>
